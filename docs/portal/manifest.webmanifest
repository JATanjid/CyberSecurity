{
  "name": "CHCS Staff Portal",
  "short_name": "CHCS Portal",
  "description": "Complete Home Care Services staff and employee portal: time clock, schedules, chat, in-services and more.",
  "start_url": "./#/dashboard",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#161b45",
  "theme_color": "#161b45",
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Time clock", "url": "./#/clock" },
    { "name": "Chat", "url": "./#/chat" },
    { "name": "My schedule", "url": "./#/calendar" }
  ]
}
